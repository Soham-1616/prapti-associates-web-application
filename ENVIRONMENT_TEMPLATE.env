# ── Server Config ──
PORT=5000

# ── JWT Config ──
JWT_SECRET=<YOUR_JWT_SECRET_KEY>

# ── Nodemailer SMTP Credentials ──
EMAIL_USER=<YOUR_SMTP_EMAIL_ADDRESS>
EMAIL_PASS=<YOUR_SMTP_APP_PASSWORD>

# ── Admin Panel Config ──
ADMIN_EMAIL=<ADMIN_NOTIFICATION_RECEIVER_EMAIL>
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<BCRYPT_PASSWORD_HASH>

# ── Base URL Configurations ──
BASE_URL=<BACKEND_PUBLIC_URL_OR_LOCALHOST>
