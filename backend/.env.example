# ══════════════════════════════════════════════
#  ENVIRONMENT VARIABLES — Prapti Associates
# ══════════════════════════════════════════════
# Copy this file to backend/.env and fill in your values.

# ── Server ──
PORT=5000

# ── Email Service (Brevo / Sendinblue) ──
# Sign up at https://brevo.com → SMTP & API → Generate API Key
BREVO_API_KEY=YOUR_BREVO_API_KEY

# ── Sender Email (the "from" address for outgoing emails) ──
SENDER_EMAIL=YOUR_SENDER_EMAIL@gmail.com

# ── Admin Email (receives appointment/contact/feedback notifications) ──
ADMIN_EMAIL=YOUR_ADMIN_NOTIFICATION_EMAIL@gmail.com

# ── Admin Panel Credentials ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=YOUR_BCRYPT_PASSWORD_HASH

# ── JWT Secret (use a long random string) ──
JWT_SECRET=YOUR_JWT_SECRET_KEY
